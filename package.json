{
  "name": "pct",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "content:validate": "node scripts/validate-content.mjs",
    "content:extract": "node scripts/content/word/extractWordJournal.ts",
    "media:extract-word": "node scripts/media/extractWord.ts",
    "media:match": "node scripts/media/match.ts",
    "media:approve": "node scripts/media/approve.ts",
    "media:generate": "node scripts/media/generate.ts",
    "media:validate": "node scripts/media/validate.ts",
    "media:upload": "node scripts/media/upload.ts",
    "route:import": "node scripts/map/importPctRoute.ts",
    "route:preview": "node scripts/map/renderRoutePreview.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm content:validate && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/blob": "2.8.0",
    "@xmldom/xmldom": "0.9.12",
    "cross-env": "10.1.0",
    "eslint": "10.0.1",
    "eslint-plugin-astro": "3.1.0",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "image-size": "2.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
