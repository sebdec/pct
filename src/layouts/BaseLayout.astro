---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import pctMarkUrl from "../assets/pct-mark.svg?url";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  bodyClass,
} = Astro.props;
const usesFlatTrailBackground = ["journal-shell", "trail-shell"].some(
  (className) => bodyClass?.includes(className),
);
const themeColor = usesFlatTrailBackground ? "#282c35" : "#191d27";
---

<!doctype html>
<html lang={site.language} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={pctMarkUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <div class="page-tail">
      <div class="page-supplement">
        <slot name="page-supplement" />
      </div>
      <div class="page-end">
        <SiteFooter />
      </div>
    </div>

    <script>
      import { configureExternalLinks } from "../lib/navigation/externalLinks";
      import { configureDisplayPreferences } from "../lib/preferences/displayPreferencesBrowser.ts";

      configureExternalLinks(document);
      configureDisplayPreferences(document);
    </script>
  </body>
</html>

<style>
  .page-tail {
    width: min(100% - 3rem, var(--pct-content-page));
    margin: var(--pct-space-7) auto 0;
  }

  .page-end {
    border-top: 1px solid var(--pct-color-faint);
  }

  @media (max-width: 46rem) {
    .page-tail {
      width: min(100% - 2rem, var(--pct-content-page));
    }
  }
</style>
