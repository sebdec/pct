---
import "../styles/global.css";

import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  bodyClass,
} = Astro.props;
const usesFlatTrailBackground = ["journal-shell", "trail-shell"].some(
  (className) => bodyClass?.includes(className),
);
const themeColor = usesFlatTrailBackground ? "#282c35" : "#191d27";
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />

    <script>
      import { configureExternalLinks } from "../lib/navigation/externalLinks";
      import { configureDisplayPreferences } from "../lib/preferences/displayPreferencesBrowser.ts";

      configureExternalLinks(document);
      configureDisplayPreferences(document);
    </script>
  </body>
</html>
