---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import pctMarkUrl from "../assets/pct-mark.svg?url";
import SiteFooter from "../components/SiteFooter.astro";
import {
  defaultLocale,
  localeFormattingTags,
  localeLanguageTags,
  publishedLocales,
  type Locale,
} from "../lib/content/locales.ts";
import { getLocalizedLinks } from "../lib/i18n/metadata.ts";
import { buildStructuredData } from "../lib/seo/structuredData.ts";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  locale?: Locale;
  journal?: {
    headline: string;
    datePublished: string;
  };
}

const {
  title = site.title,
  locale = defaultLocale,
  description = site.descriptions[locale],
  bodyClass,
  journal,
} = Astro.props;
const usesFlatTrailBackground = ["journal-shell", "trail-shell"].some(
  (className) => bodyClass?.includes(className),
);
const themeColor = usesFlatTrailBackground ? "#282c35" : "#191d27";
const localizedLinks = getLocalizedLinks(Astro.url.pathname, locale);
const canonicalPath = localizedLinks.find(
  ({ locale: linkLocale }) => linkLocale === locale,
)?.path;
const alternateOgLocales = publishedLocales.filter(
  (publishedLocale) => publishedLocale !== locale,
);

if (!canonicalPath) throw new Error(`Missing canonical path for ${locale}.`);

const absoluteUrl = (path: string) => new URL(path, Astro.site);
const canonicalUrl = absoluteUrl(canonicalPath).toString();
const socialCardUrl = absoluteUrl(site.socialCardPath).toString();
const structuredData = buildStructuredData({
  canonicalUrl,
  title,
  description,
  locale,
  journal,
});
const socialCardAlt =
  locale === "fr"
    ? "Pacific Crest Trail 2026, montagnes et sapin"
    : "Pacific Crest Trail 2026, mountains and pine tree";
---

<!doctype html>
<html lang={localeLanguageTags[locale]} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="sitemap" href={absoluteUrl("/sitemap.xml")} />
    <link rel="canonical" href={absoluteUrl(canonicalPath)} />
    {
      localizedLinks.map(({ locale: linkLocale, path }) => (
        <link rel="alternate" hreflang={linkLocale} href={absoluteUrl(path)} />
      ))
    }
    <meta property="og:type" content={journal ? "article" : "website"} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(canonicalPath)} />
    <meta property="og:image" content={socialCardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialCardAlt} />
    <meta
      property="og:locale"
      content={localeFormattingTags[locale].replace("-", "_")}
    />
    {
      alternateOgLocales.map((alternateLocale) => (
        <meta
          property="og:locale:alternate"
          content={localeFormattingTags[alternateLocale].replace("-", "_")}
        />
      ))
    }
    {
      journal && (
        <meta
          property="article:published_time"
          content={journal.datePublished}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCardUrl} />
    <meta name="twitter:image:alt" content={socialCardAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <link rel="icon" type="image/svg+xml" href={pctMarkUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <Analytics />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <div class="page-tail">
      <div class="page-supplement">
        <slot name="page-supplement" />
      </div>
      <div class="page-end">
        <SiteFooter />
      </div>
    </div>

    <script>
      import { configureExternalLinks } from "../lib/navigation/externalLinks";
      import { configureDisplayPreferences } from "../lib/preferences/displayPreferencesBrowser.ts";

      configureExternalLinks(document);
      configureDisplayPreferences(document);
      document.addEventListener("astro:page-load", () => {
        configureDisplayPreferences(document);
      });
    </script>
  </body>
</html>

<style>
  .page-tail {
    width: min(100% - 3rem, var(--pct-content-page));
    margin: var(--pct-space-7) auto 0;
  }

  .page-end {
    border-top: 1px solid var(--pct-color-faint);
  }

  @media (max-width: 46rem) {
    .page-tail {
      width: min(100% - 2rem, var(--pct-content-page));
    }
  }
</style>
