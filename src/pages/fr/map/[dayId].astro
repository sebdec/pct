---
import { getCollection } from "astro:content";
import TrailMapPage from "../../../components/TrailMapPage.astro";
import { buildMapStaticPaths } from "../../../lib/map/mapPages.ts";

interface Props {
  dayId: string;
}

export async function getStaticPaths() {
  const days = (await getCollection("days")).map(({ data }) => data);
  return buildMapStaticPaths(days);
}

const { dayId } = Astro.props;
---

<TrailMapPage initialDayId={dayId} locale="fr" />
