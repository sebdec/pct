---
import { render } from "astro:content";

import JournalDayHeader from "../../components/JournalDayHeader.astro";
import JournalDayNavigator from "../../components/JournalDayNavigator.astro";
import JournalMediaSequence from "../../components/JournalMediaSequence.astro";
import JournalMetrics from "../../components/JournalMetrics.astro";
import JournalNavigation from "../../components/JournalNavigation.astro";
import ReadingPageLayout from "../../layouts/ReadingPageLayout.astro";
import {
  getJournalStaticPaths,
  type JournalPageProps,
} from "../../lib/content/journalPages.ts";
import { getUi } from "../../lib/i18n/ui.ts";
import { site } from "../../lib/site.ts";

type Props = JournalPageProps;

export async function getStaticPaths() {
  return getJournalStaticPaths("en");
}

const { locale, page, journalEntry, navigatorEntries, sections } = Astro.props;
const labels = getUi(locale);
const { Content } = await render(journalEntry);
const pageTitle = `${labels.day} ${page.day.sequence} ${page.entry.locationLabel} | ${site.title}`;
const pageDescription =
  page.entry.summary ??
  (locale === "fr"
    ? `Journal du Pacific Crest Trail 2026 à ${page.entry.locationLabel}.`
    : `Pacific Crest Trail 2026 journal from ${page.entry.locationLabel}.`);
---

<ReadingPageLayout
  title={pageTitle}
  description={pageDescription}
  mainClass="journal-page"
  journal={{
    headline: `${labels.day} ${page.day.sequence} ${page.entry.locationLabel}`,
    datePublished: page.day.date,
  }}
  {locale}
>
  <article>
    <JournalDayHeader page={page} {locale} />
    <JournalDayNavigator page={page} entries={navigatorEntries} {locale} />

    <div class="journal-transition-surface">
      <JournalMetrics page={page} sections={sections} {locale} />

      <div class="journal-layout">
        <div class="reading-column">
          <div class="journal-copy">
            <Content />
          </div>

          <JournalMediaSequence
            photos={page.photos}
            regionId={page.regionId}
            {locale}
          />
        </div>
      </div>

      <JournalNavigation previous={page.previous} next={page.next} {locale} />
    </div>
  </article>
</ReadingPageLayout>

<style>
  :global(.journal-page) {
    min-height: 100vh;
    overflow: hidden;
    background: var(--pct-color-night-trail);
  }

  .journal-transition-surface {
    view-transition-name: journal-day;
  }

  article {
    width: 100%;
    margin: 0;
    padding-bottom: var(--pct-space-8);
  }

  .journal-layout {
    width: min(100%, var(--pct-content-page));
    margin: 0 auto;
  }

  .reading-column {
    min-width: 0;
  }

  .journal-copy {
    color: var(--pct-color-copy);
    font-family: var(--pct-font-journal);
    font-size: clamp(1.06rem, 1.25vw, 1.12rem);
    line-height: 1.78;
  }

  .journal-copy :global(p) {
    margin: 0 0 1.7em;
  }

  .journal-copy :global(p:first-child) {
    color: var(--pct-color-white);
    font-size: 1em;
  }

  .journal-copy :global(strong) {
    color: var(--pct-color-white);
    font-weight: 600;
  }

  .journal-copy :global(a) {
    color: var(--pct-color-pine-glow);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .journal-copy :global(h2),
  .journal-copy :global(h3) {
    margin: 2.5em 0 0.8em;
    color: var(--pct-color-white);
    font-family: var(--pct-font-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .journal-copy :global(blockquote) {
    margin: 2.5rem 0;
    padding-left: var(--pct-space-5);
    border-left: 2px solid var(--pct-color-pine-glow);
    color: var(--pct-color-muted);
    font-style: italic;
  }

  @media (max-width: 36rem) {
    .journal-copy {
      font-size: 1.05rem;
      line-height: 1.78;
    }
  }
</style>
