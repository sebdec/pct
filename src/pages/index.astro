---
import SiteHeader from "../components/SiteHeader.astro";
import TrailSketch from "../components/TrailSketch.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow">Journal de marche</p>
        <h1 id="page-title">Pacific Crest Trail <span>2026</span></h1>
        <p class="lead">
          Un récit à parcourir comme le trail lui-même. Des jours, des miles et
          des paysages reliés sur une même ligne.
        </p>

        <a class="explore-link" href="/map">
          <span>Voir la carte</span>
          <svg viewBox="0 0 28 12" aria-hidden="true">
            <path d="M0 6h25M20 1l5 5-5 5"></path>
          </svg>
        </a>

        <dl>
          <div>
            <dt>Format</dt>
            <dd>Journal interactif</dd>
          </div>
          <div>
            <dt>Parcours</dt>
            <dd>Mexique → Canada</dd>
          </div>
        </dl>
      </div>

      <div id="explorer" class="hero-map">
        <TrailSketch />
      </div>
    </section>

    <section id="journal" class="manifesto" aria-labelledby="manifesto-title">
      <p class="section-number">01 / Le journal</p>
      <div>
        <h2 id="manifesto-title">
          Lire une journée.<br />Retrouver sa place sur le trail.
        </h2>
        <p>
          Le journal raconte chaque journée. La carte offre un autre point de
          vue, plus simple et plus visuel, pour suivre les jours, les miles et
          les chiffres du parcours.
        </p>
      </div>
    </section>

    <section class="coming" aria-label="Contenus à venir">
      <article id="equipement">
        <span>02</span>
        <h2>Équipement</h2>
        <p>
          Le matériel emporté, les choix qui ont tenu et ceux qui ont évolué.
        </p>
      </article>
      <article id="glossaire">
        <span>03</span>
        <h2>Glossaire</h2>
        <p>
          Les mots, habitudes et détails qui composent la vie quotidienne sur le
          PCT.
        </p>
      </article>
      <div class="status">
        <span class="status-dot"></span>
        <p>Le journal complet est en préparation.</p>
      </div>
    </section>
  </main>

  <footer>
    <p>Pacific Crest Trail 2026</p>
    <p>Un projet de Sébastien Decrême</p>
  </footer>
</BaseLayout>

<style>
  main {
    overflow: hidden;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.82fr) minmax(30rem, 1.18fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    width: min(100% - 3rem, var(--pct-content-wide));
    min-height: calc(100vh - 5.25rem);
    margin: 0 auto;
    padding: var(--pct-space-7) 0;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-number {
    margin: 0 0 1.25rem;
    color: var(--pct-color-pine-glow);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--pct-color-white);
    font-size: clamp(3.5rem, 7vw, 7.4rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  h1 span {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 48%);
  }

  .lead {
    max-width: 31rem;
    margin: 2rem 0 0;
    color: var(--pct-color-copy);
    font-family: var(--pct-font-journal);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.8;
  }

  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--pct-color-pine-glow);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .explore-link svg {
    width: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(3rem, 8vh, 6rem) 0 0;
  }

  dt {
    margin-bottom: 0.45rem;
    color: var(--pct-color-muted);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--pct-color-copy);
    font-size: 0.68rem;
  }

  .manifesto {
    display: grid;
    grid-template-columns: minmax(10rem, 0.55fr) minmax(18rem, 1.45fr);
    gap: 3rem;
    width: min(100% - 3rem, var(--pct-content-wide));
    margin: 0 auto;
    padding: clamp(6rem, 13vw, 12rem) 0;
    border-top: 1px solid var(--pct-color-faint);
  }

  .manifesto h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--pct-color-white);
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.055em;
  }

  .manifesto div p {
    max-width: var(--pct-content-reading);
    margin: 2.4rem 0 0;
    color: var(--pct-color-muted);
    font-family: var(--pct-font-journal);
    font-size: 1rem;
    line-height: 1.85;
  }

  .coming {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100% - 3rem, var(--pct-content-wide));
    margin: 0 auto var(--pct-space-8);
    border-top: 1px solid var(--pct-color-faint);
    border-bottom: 1px solid var(--pct-color-faint);
  }

  article {
    min-height: 18rem;
    padding: 2rem;
    border-right: 1px solid var(--pct-color-faint);
  }

  article:nth-child(2) {
    border-right: 0;
  }

  article span {
    color: var(--pct-color-pine-glow);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
  }

  article h2 {
    margin: 5rem 0 1rem;
    color: var(--pct-color-white);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  article p {
    max-width: 25rem;
    margin: 0;
    color: var(--pct-color-muted);
    font-family: var(--pct-font-journal);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .status {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.15rem 2rem;
    border-top: 1px solid var(--pct-color-faint);
  }

  .status p {
    margin: 0;
    color: var(--pct-color-muted);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--pct-color-pine-glow);
    box-shadow: 0 0 0 0.3rem var(--pct-color-pine-glow-soft);
  }

  footer {
    display: flex;
    justify-content: space-between;
    width: min(100% - 3rem, var(--pct-content-wide));
    margin: 0 auto;
    padding: 0 0 2rem;
    color: var(--pct-color-muted);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 64rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding-top: 5rem;
    }

    .hero-copy {
      max-width: 38rem;
    }

    h1 {
      font-size: clamp(4rem, 12vw, 7rem);
    }

    dl {
      margin-top: 3rem;
    }

    .hero-map {
      width: 100%;
    }
  }

  @media (max-width: 40rem) {
    .hero,
    .manifesto,
    .coming,
    footer {
      width: min(100% - 2rem, var(--pct-content-wide));
    }

    .hero {
      gap: 3rem;
      min-height: auto;
      padding: 4rem 0 5rem;
    }

    h1 {
      font-size: clamp(3.45rem, 17vw, 5rem);
    }

    .lead {
      font-size: 0.95rem;
    }

    .manifesto {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 6rem 0;
    }

    .manifesto div p {
      font-size: 0.9rem;
    }

    .coming {
      grid-template-columns: 1fr;
    }

    article {
      min-height: 15rem;
      border-right: 0;
      border-bottom: 1px solid var(--pct-color-faint);
    }

    article:nth-child(2) {
      border-bottom: 0;
    }

    article h2 {
      margin-top: 3rem;
    }

    footer {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
