---
import TrailOverviewMetrics from "../components/TrailOverviewMetrics.tsx";
import TextLink from "../components/TextLink.astro";
import { Content as HomeContent } from "../content/home/fr.md";
import { homeIntroduction, homeOverview } from "../content/home/fr.ts";
import EditorialPageLayout from "../layouts/EditorialPageLayout.astro";
---

<EditorialPageLayout
  title="Pacific Crest Trail 2026"
  description="Le journal, la carte et les chiffres d’un thru-hike de 2 656 miles sur le Pacific Crest Trail en 2026."
  heading="Pacific Crest Trail 2026"
  bodyClass="home-shell"
  width="reading"
>
  <article class="editorial-rich-text">
    <p>
      {homeIntroduction.beforeLink}<TextLink
        href={homeIntroduction.linkHref}
        external>{homeIntroduction.linkLabel}</TextLink
      >{homeIntroduction.afterLink}
    </p>
    <TrailOverviewMetrics {...homeOverview} />
    <HomeContent />
  </article>
</EditorialPageLayout>
