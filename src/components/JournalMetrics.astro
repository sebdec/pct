---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import {
  defaultLocale,
  localeFormattingTags,
  type Locale,
} from "../lib/content/locales.ts";
import type { TrailSection } from "../lib/content/schemas.ts";
import TrailMetrics from "./TrailMetrics.tsx";

interface Props {
  page: JournalPageViewModel;
  sections: readonly TrailSection[];
  locale?: Locale;
}

const { page, sections, locale = defaultLocale } = Astro.props;
const integerFormatter = new Intl.NumberFormat(localeFormattingTags[locale], {
  maximumFractionDigits: 0,
});
---

{
  page.metrics && page.regionId && (
    <TrailMetrics
      regionId={page.regionId}
      regionLabel={page.regionLabel}
      sections={sections}
      positionMiles={{
        start: page.metrics.mileStart,
        end: page.metrics.mileEnd,
      }}
      distanceMiles={page.metrics.distanceMiles}
      ascentLabel={`+${integerFormatter.format(page.metrics.ascentMeters)} m`}
      descentLabel={`−${integerFormatter.format(page.metrics.descentMeters)} m`}
      {locale}
    />
  )
}
