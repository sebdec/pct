---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import type { TrailSection } from "../lib/content/schemas.ts";
import MetricIcon from "./MetricIcon.astro";

interface Props {
  page: JournalPageViewModel;
  sections: readonly TrailSection[];
}

const { page, sections } = Astro.props;
const decimalFormatter = new Intl.NumberFormat("fr-FR", {
  maximumFractionDigits: 1,
});
const integerFormatter = new Intl.NumberFormat("fr-FR", {
  maximumFractionDigits: 0,
});
---

{
  page.metrics && (
    <aside
      class="metrics"
      aria-label="Repères de la journée"
      data-region={page.regionId}
    >
      <dl>
        <div class="context-metric region-metric">
          <dt>
            <>
              <MetricIcon name="region" />
              <span>Région</span>
            </>
          </dt>
          <dd class="region-name">{page.regionLabel}</dd>
        </div>
        <div class="context-metric section-metric">
          <dt>
            <>
              <MetricIcon name="section" />
              <span>Section</span>
            </>
          </dt>
          <dd class="section-list">
            {sections.map((section) => (
              <span>
                <strong>{section.code}</strong> {section.properName}
              </span>
            ))}
          </dd>
        </div>
        <div class="metric position-metric">
          <dt>
            <>
              <MetricIcon name="mile" />
              <span>Position</span>
            </>
          </dt>
          <dd>
            {decimalFormatter.format(page.metrics.mileStart)} →{" "}
            {decimalFormatter.format(page.metrics.mileEnd)} mi
          </dd>
        </div>
        <div class="metric distance-metric">
          <dt>
            <>
              <MetricIcon name="distance" />
              <span>Distance</span>
            </>
          </dt>
          <dd>{decimalFormatter.format(page.metrics.distanceMiles)} mi</dd>
        </div>
        <div class="metric ascent-metric">
          <dt>
            <>
              <MetricIcon name="ascent" />
              <span>Ascension</span>
            </>
          </dt>
          <dd>+{integerFormatter.format(page.metrics.ascentMeters)} m</dd>
        </div>
        <div class="metric descent-metric">
          <dt>
            <>
              <MetricIcon name="descent" />
              <span>Descente</span>
            </>
          </dt>
          <dd>−{integerFormatter.format(page.metrics.descentMeters)} m</dd>
        </div>
      </dl>
    </aside>
  )
}

<style>
  .metrics {
    --region-color: var(--pct-color-pine-glow);

    width: min(100%, var(--pct-content-reading));
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    padding: var(--pct-space-4) 0;
  }

  .metrics[data-region="desert"] {
    --region-color: var(--pct-color-desert-dust);
  }

  .metrics[data-region="sierra"] {
    --region-color: var(--pct-color-sierra-snow);
  }

  .metrics[data-region="norcal"] {
    --region-color: var(--pct-color-norcal-forest);
  }

  .metrics[data-region="oregon"] {
    --region-color: var(--pct-color-oregon-lake);
  }

  .metrics[data-region="washington"] {
    --region-color: var(--pct-color-washington-mist);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
  }

  .metric,
  .context-metric {
    display: grid;
    grid-template-rows: 1.25rem auto;
    gap: var(--pct-space-1);
    min-width: 0;
    padding-inline: var(--pct-space-4);
    border-right: 1px solid var(--pct-color-faint);
  }

  .position-metric {
    padding-left: 0;
  }

  .descent-metric {
    padding-right: 0;
    border-right: 0;
  }

  .context-metric {
    grid-template-rows: auto auto;
    margin-bottom: var(--pct-space-4);
    padding-bottom: var(--pct-space-4);
    border-bottom: 1px solid var(--pct-color-faint);
  }

  .region-metric {
    position: relative;
    grid-column: 1;
    padding-left: 0;
    border-right: 0;
  }

  .region-metric::after {
    position: absolute;
    top: var(--pct-space-1);
    right: 0;
    bottom: var(--pct-space-2);
    width: 1px;
    background: var(--pct-color-faint);
    content: "";
  }

  .section-metric {
    grid-column: 2 / -1;
    padding-right: 0;
    border-right: 0;
  }

  .region-name {
    color: var(--region-color);
  }

  .section-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pct-space-2) var(--pct-space-4);
  }

  .section-list span + span::before {
    margin-right: var(--pct-space-4);
    color: var(--pct-color-faint);
    content: "/";
  }

  .section-list strong {
    margin-right: var(--pct-space-1);
    color: var(--pct-color-white);
    font-weight: 700;
  }

  dt {
    display: flex;
    gap: var(--pct-space-2);
    align-items: center;
    margin: 0;
    color: var(--pct-color-muted);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--pct-color-copy);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  @media (max-width: 46rem) {
    dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--pct-space-5) 0;
    }

    .position-metric,
    .ascent-metric {
      grid-column: 1 / span 2;
    }

    .distance-metric,
    .descent-metric {
      grid-column: 3 / span 2;
    }

    .distance-metric {
      padding-right: 0;
      border-right: 0;
    }

    .ascent-metric {
      padding-left: 0;
    }

    .descent-metric {
      border-right: 0;
    }

    .region-metric {
      grid-column: 1;
    }

    .section-metric {
      grid-column: 2 / -1;
    }

    .section-list {
      display: grid;
      gap: var(--pct-space-2);
    }

    .section-list span + span::before {
      display: none;
    }
  }
</style>
