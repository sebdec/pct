---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import type { Locale } from "../lib/content/locales.ts";
import type { TrailSection } from "../lib/content/schemas.ts";
import TrailMetrics from "./TrailMetrics.tsx";

interface Props {
  page: JournalPageViewModel;
  sections: readonly TrailSection[];
  locale: Locale;
}

const { page, sections, locale } = Astro.props;
---

{
  page.metrics && page.regionId && (
    <TrailMetrics
      regionId={page.regionId}
      regionLabel={page.regionLabel}
      sections={sections}
      positionMiles={{
        start: page.metrics.mileStart,
        end: page.metrics.mileEnd,
      }}
      distanceMiles={page.metrics.distanceMiles}
      ascentMeters={page.metrics.ascentMeters}
      descentMeters={page.metrics.descentMeters}
      {locale}
    />
  )
}
