---
import { site } from "../lib/site";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href.startsWith("/journal")) {
    return currentPath.startsWith("/journal");
  }

  return !href.includes("#") && href === currentPath;
}
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.title}, accueil`}>
    <span>Pacific Crest Trail</span>
    <small>2026</small>
  </a>

  <nav aria-label="Navigation principale">
    <ul>
      {
        site.navigation.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={{ active: isActive(href) }}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav class="mobile-navigation" aria-label="Navigation principale mobile">
    <a
      class:list={{ active: currentPath.startsWith("/journal") }}
      href="/journal/day-001"
      aria-current={currentPath.startsWith("/journal") ? "page" : undefined}
    >
      Journal
    </a>
    <a
      class:list={{ active: currentPath === "/map" }}
      href="/map"
      aria-current={currentPath === "/map" ? "page" : undefined}
    >
      Carte
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 3rem, var(--pct-content-wide));
    min-height: 5.25rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--pct-color-faint);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: var(--pct-space-2);
    color: var(--pct-color-pine-glow);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark small {
    color: var(--pct-color-muted);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--pct-color-muted);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--pct-color-pine-glow);
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: var(--pct-color-pine-glow);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  nav a.active,
  nav a.active {
    color: var(--pct-color-pine-glow);
  }

  nav a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .mobile-navigation {
    display: none;
    gap: 1rem;
  }

  .mobile-navigation a {
    position: relative;
    color: var(--pct-color-pine-glow);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 48rem) {
    .site-header {
      width: min(100% - 2rem, var(--pct-content-wide));
    }

    nav {
      display: none;
    }

    .site-header > nav:not(.mobile-navigation) {
      display: none;
    }

    .mobile-navigation {
      display: flex;
    }
  }
</style>
