---
import pctMark from "../assets/pct-mark.svg?raw";
import { site } from "../lib/site";
import HeaderPreferences from "./HeaderPreferences.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href.startsWith("/journal")) {
    return currentPath.startsWith("/journal");
  }

  if (href === "/map") {
    return currentPath.startsWith("/map");
  }

  if (href === "/gear" || href === "/glossary") {
    return currentPath.startsWith(href);
  }

  return !href.includes("#") && href === currentPath;
}

function navigationHref(label: string, href: string): string {
  if (label === "Journal" && currentPath.startsWith("/journal/")) {
    return currentPath;
  }

  return href;
}
---

<header class="site-header">
  <div class="site-header__row">
    <div class="site-header__left">
      <a class="wordmark" href="/" aria-label={`${site.title}, accueil`}>
        <span class="wordmark__mark" set:html={pctMark} />
        <span class="wordmark__text">
          <span>Pacific Crest Trail</span>
          <small>2026</small>
        </span>
      </a>

      <nav aria-label="Navigation principale">
        <ul>
          {
            site.navigation.map(({ label, href }) => (
              <li>
                <a
                  href={navigationHref(label, href)}
                  class:list={{ active: isActive(href) }}
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <HeaderPreferences />
  </div>

  <nav class="mobile-navigation" aria-label="Navigation principale mobile">
    {
      site.navigation.map(({ label, href }) => (
        <a
          href={navigationHref(label, href)}
          class:list={{ active: isActive(href) }}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    width: min(100% - 3rem, var(--pct-content-wide));
    min-height: 5.25rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--pct-color-faint);
  }

  .site-header__row {
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--pct-space-5);
  }

  .site-header__left {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--pct-space-2);
    color: var(--pct-color-pine-glow);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark__mark {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    flex: 0 0 auto;
  }

  .wordmark__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
    gap: var(--pct-space-3);
  }

  .wordmark small {
    color: var(--pct-color-muted);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--pct-color-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--pct-color-pine-glow);
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: var(--pct-color-pine-glow);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  nav a.active {
    color: var(--pct-color-pine-glow);
  }

  nav a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .mobile-navigation {
    display: none;
    gap: 1rem;
  }

  .mobile-navigation a {
    position: relative;
    color: var(--pct-color-muted);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .site-header {
      width: min(100% - 2rem, var(--pct-content-wide));
      padding: var(--pct-space-4) 0;
    }

    .site-header__row {
      width: 100%;
      min-height: 0;
    }

    .site-header__left {
      min-width: 0;
    }

    nav {
      display: none;
    }

    .site-header > nav:not(.mobile-navigation) {
      display: none;
    }

    .mobile-navigation {
      display: flex;
      justify-content: space-between;
      width: 100%;
      gap: var(--pct-space-3);
    }

    .mobile-navigation a {
      font-size: 0.58rem;
    }
  }
</style>
