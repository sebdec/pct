---
import type {
  JournalNavigatorItem,
  JournalPageViewModel,
} from "../lib/content/journalViewModel.ts";
import { journalDayUrl } from "../lib/content/urls.ts";

interface Props {
  page: JournalPageViewModel;
  entries: readonly JournalNavigatorItem[];
}

const { page, entries } = Astro.props;
const currentIndex = entries.findIndex(({ dayId }) => dayId === page.day.id);

if (currentIndex < 0) {
  throw new Error(`Missing journal navigator entry for ${page.day.id}.`);
}

const current = entries[currentIndex];
const previous = currentIndex > 0 ? entries[currentIndex - 1] : null;
const next =
  currentIndex < entries.length - 1 ? entries[currentIndex + 1] : null;
function progressStop(index: number, entryCount: number): string {
  const ratio = entryCount > 1 ? index / (entryCount - 1) : 1;
  const percent = Number((ratio * 100).toFixed(4));
  const thumbCorrection = Number((0.75 * (1 - 2 * ratio)).toFixed(4));
  const operator = thumbCorrection >= 0 ? "+" : "-";

  return `calc(${percent}% ${operator} ${Math.abs(thumbCorrection)}rem)`;
}

const currentProgressStop = progressStop(currentIndex, entries.length);
const navigatorEntries = entries.map((entry) => ({
  sequence: entry.sequence,
  regionId: entry.regionId,
  regionLabel: entry.regionLabel,
  mileStart: entry.mileStart,
  mileEnd: entry.mileEnd,
  href: journalDayUrl(entry.dayId),
}));

function positionLabel(entry: JournalNavigatorItem): string | null {
  if (entry.mileStart === null || entry.mileEnd === null) {
    return null;
  }

  return `${entry.mileStart.toLocaleString("fr-FR", { maximumFractionDigits: 1 })} → ${entry.mileEnd.toLocaleString("fr-FR", { maximumFractionDigits: 1 })} mi`;
}

const currentPositionLabel = positionLabel(current);
---

<nav
  class="day-navigator"
  aria-label="Accès rapide aux journées"
  data-journal-navigator
  data-entries={JSON.stringify(navigatorEntries)}
  data-preview-region={current.regionId ?? "after-trail"}
  style={`--day-progress: ${currentProgressStop}`}
>
  {
    previous ? (
      <a
        class="step-link previous"
        href={journalDayUrl(previous.dayId)}
        aria-label={`Jour précédent, jour ${previous.sequence}`}
      >
        <span aria-hidden="true">←</span>
      </a>
    ) : (
      <span class="step-boundary" aria-hidden="true" />
    )
  }

  <div class="range-control">
    <div class="range-copy">
      <strong data-day-label>Jour {current.sequence}</strong>
      <span data-region-label>{current.regionLabel}</span>
      <small data-position-label hidden={!currentPositionLabel}>
        {currentPositionLabel}
      </small>
    </div>

    <label class="visually-hidden" for={`journal-day-${page.day.id}`}>
      Choisir une journée du journal
    </label>
    <input
      id={`journal-day-${page.day.id}`}
      type="range"
      min="1"
      max={entries.length}
      value={currentIndex + 1}
      aria-valuetext={[
        `Jour ${current.sequence}`,
        current.regionLabel,
        currentPositionLabel,
      ]
        .filter(Boolean)
        .join(", ")}
      data-day-range
      disabled
    />
  </div>

  {
    next ? (
      <a
        class="step-link next"
        href={journalDayUrl(next.dayId)}
        aria-label={`Jour suivant, jour ${next.sequence}`}
      >
        <span aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="step-boundary" aria-hidden="true" />
    )
  }
</nav>

<script>
  interface NavigatorEntry {
    sequence: number;
    regionId: "desert" | "sierra" | "norcal" | "oregon" | "washington" | null;
    regionLabel: string;
    mileStart: number | null;
    mileEnd: number | null;
    href: string;
  }

  const formatMile = new Intl.NumberFormat("fr-FR", {
    maximumFractionDigits: 1,
  });

  function entryPositionLabel(entry: NavigatorEntry): string | null {
    if (entry.mileStart === null || entry.mileEnd === null) {
      return null;
    }

    return `${formatMile.format(entry.mileStart)} → ${formatMile.format(entry.mileEnd)} mi`;
  }

  function progressStop(index: number, entryCount: number): string {
    const ratio = entryCount > 1 ? index / (entryCount - 1) : 1;
    const percent = Number((ratio * 100).toFixed(4));
    const thumbCorrection = Number((0.75 * (1 - 2 * ratio)).toFixed(4));
    const operator = thumbCorrection >= 0 ? "+" : "-";

    return `calc(${percent}% ${operator} ${Math.abs(thumbCorrection)}rem)`;
  }

  for (const navigator of document.querySelectorAll<HTMLElement>(
    "[data-journal-navigator]",
  )) {
    const range = navigator.querySelector<HTMLInputElement>("[data-day-range]");
    const dayLabel = navigator.querySelector<HTMLElement>("[data-day-label]");
    const regionLabel = navigator.querySelector<HTMLElement>(
      "[data-region-label]",
    );
    const positionLabel = navigator.querySelector<HTMLElement>(
      "[data-position-label]",
    );
    const rawEntries = navigator.dataset.entries;

    if (!range || !dayLabel || !regionLabel || !positionLabel || !rawEntries) {
      continue;
    }

    const entries = JSON.parse(rawEntries) as NavigatorEntry[];
    const currentIndex = Number(range.value) - 1;

    range.disabled = false;

    const preview = (index: number) => {
      const boundedIndex = Math.max(0, Math.min(entries.length - 1, index));
      const entry = entries[boundedIndex];
      const position = entryPositionLabel(entry);

      dayLabel.textContent = `Jour ${entry.sequence}`;
      regionLabel.textContent = entry.regionLabel;
      navigator.dataset.previewRegion = entry.regionId ?? "after-trail";
      positionLabel.textContent = position ?? "";
      positionLabel.hidden = position === null;
      navigator.style.setProperty(
        "--day-progress",
        progressStop(boundedIndex, entries.length),
      );
      range.setAttribute(
        "aria-valuetext",
        [`Jour ${entry.sequence}`, entry.regionLabel, position]
          .filter(Boolean)
          .join(", "),
      );
    };

    range.addEventListener("input", () => preview(Number(range.value) - 1));
    range.addEventListener("pointerdown", () => {
      range.dataset.pointerFocus = "true";
    });
    range.addEventListener("keydown", () => {
      delete range.dataset.pointerFocus;
    });
    range.addEventListener("change", () => {
      const entry = entries[Number(range.value) - 1];

      if (entry) {
        window.location.assign(entry.href);
      }
    });
    range.addEventListener("blur", () => {
      delete range.dataset.pointerFocus;
      preview(currentIndex);
    });
  }
</script>

<style>
  .day-navigator {
    --navigator-color: var(--pct-color-muted);
    --progress-color: var(--pct-color-pine-glow);

    position: sticky;
    z-index: 8;
    top: var(--pct-space-3);
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    gap: var(--pct-space-3);
    align-items: center;
    width: min(100%, 48rem);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    margin-inline: auto;
    padding: var(--pct-space-3) var(--pct-space-4);
    border-radius: var(--pct-radius-small);
    background: var(--pct-color-night-trail);
  }

  .day-navigator[data-preview-region="desert"] {
    --navigator-color: var(--pct-color-desert-dust);
  }

  .day-navigator[data-preview-region="sierra"] {
    --navigator-color: var(--pct-color-sierra-snow);
  }

  .day-navigator[data-preview-region="norcal"] {
    --navigator-color: var(--pct-color-norcal-forest);
  }

  .day-navigator[data-preview-region="oregon"] {
    --navigator-color: var(--pct-color-oregon-lake);
  }

  .day-navigator[data-preview-region="washington"] {
    --navigator-color: var(--pct-color-washington-mist);
  }

  .step-link,
  .step-boundary {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
  }

  .step-link {
    color: var(--pct-color-muted);
    font-size: 1.1rem;
    line-height: 1;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .step-link:hover {
    color: var(--pct-color-pine-glow);
  }

  .range-control {
    min-width: 0;
  }

  .range-copy {
    display: flex;
    gap: var(--pct-space-3);
    align-items: baseline;
    justify-content: center;
    min-height: 1.25rem;
    color: var(--pct-color-muted);
    font-size: 0.72rem;
  }

  .range-copy strong {
    color: var(--pct-color-white);
    font-weight: 500;
  }

  .range-copy span {
    color: var(--navigator-color);
    transition: color 160ms ease;
  }

  .range-copy small {
    font-size: inherit;
  }

  input[type="range"] {
    width: 100%;
    height: 1.25rem;
    margin: var(--pct-space-1) 0 0;
    padding: 0;
    cursor: ew-resize;
    appearance: none;
    background: transparent;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--progress-color) 0 var(--day-progress),
      var(--pct-color-faint) var(--day-progress) 100%
    );
  }

  input[type="range"]::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--progress-color) 0 var(--day-progress),
      var(--pct-color-faint) var(--day-progress) 100%
    );
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: -0.67rem;
    border: 0;
    background: url("/icons/trail-hiker.svg") center / contain no-repeat;
    filter: drop-shadow(0 0 0.25rem var(--pct-color-night-trail));
    appearance: none;
  }

  input[type="range"]::-moz-range-thumb {
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    background: url("/icons/trail-hiker.svg") center / contain no-repeat;
    filter: drop-shadow(0 0 0.25rem var(--pct-color-night-trail));
  }

  .day-navigator[data-preview-region="after-trail"]
    input[type="range"]::-webkit-slider-thumb {
    background-image: url("/icons/trail-hiker-post-trail.svg");
  }

  .day-navigator[data-preview-region="after-trail"]
    input[type="range"]::-moz-range-thumb {
    background-image: url("/icons/trail-hiker-post-trail.svg");
  }

  input[type="range"]:disabled {
    cursor: default;
    opacity: 0.72;
  }

  input[type="range"][data-pointer-focus]:focus-visible {
    outline: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 46rem) {
    .day-navigator {
      grid-template-columns: 1.75rem minmax(0, 1fr) 1.75rem;
      gap: var(--pct-space-2);
      margin-top: var(--pct-space-4);
      padding-inline: var(--pct-space-2);
    }

    .range-copy {
      gap: var(--pct-space-2);
      flex-wrap: wrap;
    }
  }
</style>
