---
import type {
  JournalNavigatorItem,
  JournalPageViewModel,
} from "../lib/content/journalViewModel.ts";
import JournalProgressControl from "./JournalProgressControl.tsx";

interface Props {
  page: JournalPageViewModel;
  entries: readonly JournalNavigatorItem[];
}

const { page, entries } = Astro.props;
---

<div class="journal-day-navigator">
  <JournalProgressControl
    currentDayId={page.day.id}
    entries={entries}
    client:load
  />
</div>

<style>
  .journal-day-navigator {
    position: sticky;
    z-index: 8;
    top: var(--pct-space-3);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
  }

  @media (max-width: 46rem) {
    .journal-day-navigator {
      margin-top: var(--pct-space-4);
    }
  }
</style>
