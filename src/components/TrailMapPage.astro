---
import { getCollection } from "astro:content";
import "maplibre-gl/dist/maplibre-gl.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale, type Locale } from "../lib/content/locales.ts";
import { buildMapDayViewModels } from "../lib/map/mapExperience.ts";
import { mapPayloadPath } from "../lib/map/mapPayload.ts";
import { site } from "../lib/site.ts";
import PageCredits from "./PageCredits.astro";
import SiteHeader from "./SiteHeader.astro";
import TrailMapExperience from "./TrailMapExperience";

interface Props {
  initialDayId?: string;
  locale?: Locale;
}

const { initialDayId, locale = defaultLocale } = Astro.props;
const [dayEntries, journalEntries, sectionEntries, routeEntries, areaEntries] =
  await Promise.all([
    getCollection("days"),
    getCollection("journal"),
    getCollection("sections"),
    getCollection("routes"),
    getCollection("mapAreas"),
  ]);
const days = buildMapDayViewModels({
  days: dayEntries.map(({ data }) => data),
  journalEntries: journalEntries.map(({ data }) => data),
  sections: sectionEntries.map(({ data }) => data),
  locale,
});
const route = routeEntries[0]?.data;
const areas = areaEntries.map(({ data }) => data);
const naturalEarthSource = areas[0]?.source;
const initialDay = initialDayId
  ? days.find(({ id }) => id === initialDayId)
  : undefined;

if (!route) {
  throw new Error("The PCT route is missing.");
}

if (!naturalEarthSource) {
  throw new Error("The map geography source is missing.");
}

if (initialDayId && !initialDay) {
  throw new Error(`Unknown map day ${initialDayId}.`);
}

const mapStyleUrl =
  import.meta.env.PUBLIC_MAP_STYLE_URL ??
  "https://tiles.openfreemap.org/styles/fiord";
const title = initialDay
  ? locale === "fr"
    ? `Jour ${initialDay.sequence} sur la carte | ${site.title}`
    : `Day ${initialDay.sequence} on the map | ${site.title}`
  : locale === "fr"
    ? `Carte du parcours | ${site.title}`
    : `Trail map | ${site.title}`;
const description =
  locale === "fr"
    ? "Parcourir les 2 656 miles du Pacific Crest Trail jour après jour."
    : "Explore all 2,656 miles of the Pacific Crest Trail day by day.";
---

<BaseLayout title={title} {description} bodyClass="trail-shell" {locale}>
  <SiteHeader {locale} />
  <main class="map-page">
    <TrailMapExperience
      days={days}
      mapPayloadUrl={mapPayloadPath}
      mapStyleUrl={mapStyleUrl}
      initialDayId={initialDayId}
      {locale}
      client:load
    />
  </main>
  <PageCredits
    slot="page-supplement"
    {locale}
    links={[
      {
        href: route.source.centerlineUrl,
        label: "Pacific Crest Trail Association",
      },
      { href: route.source.licenseUrl, label: route.source.license },
      { href: "https://openfreemap.org/", label: "OpenFreeMap" },
      { href: "https://openmaptiles.org/", label: "OpenMapTiles" },
      {
        href: "https://www.openstreetmap.org/copyright",
        label: "OpenStreetMap",
      },
      { href: naturalEarthSource.url, label: naturalEarthSource.dataset },
    ]}
  />
</BaseLayout>

<style>
  .map-page {
    min-height: calc(100vh - 5.25rem);
  }
</style>
