---
import { getCollection } from "astro:content";
import "maplibre-gl/dist/maplibre-gl.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale } from "../lib/content/locales.ts";
import { buildMapDayViewModels } from "../lib/map/mapExperience.ts";
import { site } from "../lib/site.ts";
import SiteHeader from "./SiteHeader.astro";
import TrailMapExperience from "./TrailMapExperience";

interface Props {
  initialDayId?: string;
}

const { initialDayId } = Astro.props;
const [
  dayEntries,
  journalEntries,
  sectionEntries,
  routeEntries,
  pointEntries,
  areaEntries,
] = await Promise.all([
  getCollection("days"),
  getCollection("journal"),
  getCollection("sections"),
  getCollection("routes"),
  getCollection("mapPoints"),
  getCollection("mapAreas"),
]);
const days = buildMapDayViewModels({
  days: dayEntries.map(({ data }) => data),
  journalEntries: journalEntries.map(({ data }) => data),
  sections: sectionEntries.map(({ data }) => data),
  locale: defaultLocale,
});
const route = routeEntries[0]?.data;
const points = pointEntries.map(({ data }) => data);
const areas = areaEntries.map(({ data }) => data);
const initialDay = initialDayId
  ? days.find(({ id }) => id === initialDayId)
  : undefined;

if (!route) {
  throw new Error("The PCT route is missing.");
}

if (initialDayId && !initialDay) {
  throw new Error(`Unknown map day ${initialDayId}.`);
}

const mapStyleUrl =
  import.meta.env.PUBLIC_MAP_STYLE_URL ??
  "https://tiles.openfreemap.org/styles/fiord";
const title = initialDay
  ? `Jour ${initialDay.sequence} sur la carte | ${site.title}`
  : `Carte du parcours | ${site.title}`;
---

<BaseLayout
  title={title}
  description="Parcourir les 2 656 miles du Pacific Crest Trail jour après jour."
  bodyClass="trail-shell"
>
  <SiteHeader />
  <main>
    <TrailMapExperience
      days={days}
      route={route}
      points={points}
      areas={areas}
      mapStyleUrl={mapStyleUrl}
      initialDayId={initialDayId}
      client:load
    />
  </main>

  <footer>
    <p>
      <a href={route.source.centerlineUrl}>{route.source.attribution}</a>,
      {" "}
      <a href={route.source.licenseUrl}>{route.source.license}</a>
    </p>
    <p>
      Fond de carte <a href="https://openfreemap.org/">OpenFreeMap</a>, données
      {" "}
      <a href="https://openmaptiles.org/">OpenMapTiles</a> et
      {" "}
      <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
    </p>
    <p>
      Limites administratives
      {" "}
      <a href="https://www.naturalearthdata.com/">Natural Earth</a>, domaine
      public
    </p>
  </footer>
</BaseLayout>

<style>
  main {
    min-height: calc(100vh - 5.25rem);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    justify-content: space-between;
    width: min(100% - 3rem, var(--pct-content-wide));
    margin: 0 auto;
    padding: var(--pct-space-5) 0 var(--pct-space-7);
    border-top: 1px solid var(--pct-color-faint);
    color: var(--pct-color-muted);
    font-size: 0.55rem;
    line-height: 1.6;
  }

  footer p {
    margin: 0;
  }

  footer a {
    text-underline-offset: 0.2em;
  }

  @media (max-width: 46rem) {
    footer {
      width: min(100% - 2rem, var(--pct-content-wide));
    }
  }
</style>
