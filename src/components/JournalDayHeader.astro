---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import LocalizedDate from "./LocalizedDate.astro";

interface Props {
  page: JournalPageViewModel;
  totalEntries: number;
}

const { page, totalEntries } = Astro.props;
const sequence = page.day.sequence;
const endDate = page.day.kind === "post-trail" ? page.day.endDate : undefined;
---

<header class="day-header">
  <div class="day-context">
    <p class="journal-position">
      Journal <span>{sequence} / {totalEntries}</span>
    </p>
    <p class="region-label">{page.regionLabel}</p>
  </div>

  <div class="heading-row">
    <p class="day-kicker">
      {page.day.kind === "trail" ? "Jour de marche" : "Après le terminus"}
    </p>
    <h1>
      <span class="day-word">
        {page.day.kind === "trail" ? "Jour" : "Étape"}
      </span>
      <span class="day-number">{sequence}</span>
    </h1>
  </div>

  <div class="day-place">
    <p class="date">
      <LocalizedDate start={page.day.date} end={endDate} />
    </p>
    <p class="location">{page.entry.locationLabel}</p>
  </div>
</header>

<style>
  .day-header {
    position: relative;
    padding: clamp(4rem, 9vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .day-context,
  .heading-row,
  .day-place {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--pct-space-6);
  }

  .journal-position,
  .region-label,
  .day-kicker,
  .date,
  .location {
    margin: 0;
  }

  .journal-position,
  .region-label,
  .day-kicker {
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .journal-position {
    color: var(--pct-color-muted);
  }

  .journal-position span,
  .day-kicker {
    color: var(--pct-color-pine-glow);
  }

  .region-label {
    color: var(--section-color);
  }

  .heading-row {
    display: block;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2.4rem);
    margin: 0.55rem 0 0;
    color: var(--pct-color-white);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.075em;
  }

  .day-word {
    font-size: clamp(3.25rem, 8vw, 7.5rem);
  }

  .day-number {
    color: transparent;
    font-size: clamp(2.8rem, 6.4vw, 6.2rem);
    -webkit-text-stroke: 1px var(--pct-color-muted);
  }

  .day-place {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .date {
    color: var(--pct-color-copy);
    font-family: var(--pct-font-journal);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-style: italic;
  }

  .location {
    max-width: 30rem;
    color: var(--pct-color-muted);
    font-size: 0.72rem;
    line-height: 1.5;
    text-align: right;
  }

  @media (max-width: 40rem) {
    .day-header {
      padding-top: 3rem;
    }

    .heading-row {
      margin-top: var(--pct-space-7);
    }

    h1 {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      line-height: 0.88;
    }

    .day-word {
      font-size: clamp(3rem, 15vw, 4.3rem);
    }

    .day-number {
      font-size: clamp(2.35rem, 12vw, 3.6rem);
    }

    .day-place {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--pct-space-3);
    }

    .location {
      text-align: left;
    }
  }
</style>
