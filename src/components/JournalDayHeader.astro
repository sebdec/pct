---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import { defaultLocale, type Locale } from "../lib/content/locales.ts";
import { mapDayUrl } from "../lib/content/urls.ts";
import { getUi } from "../lib/i18n/ui.ts";
import TrailDaySummary from "./TrailDaySummary.tsx";

interface Props {
  page: JournalPageViewModel;
  locale?: Locale;
}

const { page, locale = defaultLocale } = Astro.props;
const labels = getUi(locale);
const endDate = page.day.kind === "post-trail" ? page.day.endDate : undefined;
---

<TrailDaySummary
  className="journal-day-summary"
  sequence={page.day.sequence}
  locationLabel={page.entry.locationLabel}
  date={page.day.date}
  endDate={endDate}
  {locale}
  action={page.day.kind === "trail"
    ? {
        href: mapDayUrl(page.day.id, locale),
        label: labels.viewOnMap,
        reload: true,
      }
    : undefined}
/>
