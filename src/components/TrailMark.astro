---
import type { TrailDay } from "../lib/content/schemas.ts";

interface Props {
  regionId: TrailDay["regionId"];
  class?: string;
}

const { regionId, class: className } = Astro.props;
---

<svg
  class:list={["trail-mark", `trail-mark-${regionId}`, className]}
  viewBox="0 0 96 96"
  aria-hidden="true"
>
  <path class="frame" d="M30 8h36l22 22v36L66 88H30L8 66V30Z"></path>
  <path class="field" d="M16 63c17-11 29-10 43-1 10 6 19 6 29 1v17H16Z"></path>

  {
    regionId === "desert" && (
      <g class="symbol desert-symbol">
        <circle cx="69" cy="27" r="7" />
        <path d="M42 67V32c0-5 8-5 8 0v13m0 1c0 5 8 5 8 0v-6m-16 12c0 5-8 5-8 0v-7" />
      </g>
    )
  }

  {
    regionId === "sierra" && (
      <g class="symbol sierra-symbol">
        <path d="m18 68 25-37 12 17 8-11 17 31" />
        <path class="detail" d="m35 43 8-12 7 10-5-2-4 5-3-3Z" />
      </g>
    )
  }

  {
    regionId === "norcal" && (
      <g class="symbol norcal-symbol">
        <path d="m22 67 22-34 22 34" />
        <path
          class="detail"
          d="M37 44c4 2 8 2 14 0M30 67V54m-6 7 6-12 6 12m33 6V52m-7 10 7-16 8 16"
        />
      </g>
    )
  }

  {
    regionId === "oregon" && (
      <g class="symbol oregon-symbol">
        <path d="M18 56c10-5 20-5 30 0s20 5 30 0M18 65c10-5 20-5 30 0s20 5 30 0" />
        <g class="mosquito">
          <path d="m65 34 8 8m-8 0 8-8m-4 4v10m-4-4 8 1" />
          <circle cx="69" cy="38" r="1.7" />
        </g>
      </g>
    )
  }

  {
    regionId === "washington" && (
      <g class="symbol washington-symbol">
        <path class="ridge" d="m17 68 19-18 12 10 10-13 21 21" />
        <path
          class="goat-fill"
          d="M28 58c6-9 17-12 29-7l5-10 8-2 6 5-8 7-4 11H53l-2 9h-5l1-10H37l-1 10h-5l2-12Z"
        />
        <path class="goat-horns" d="M63 41c-1-6 2-10 8-13m-4 12c2-5 6-8 10-8" />
      </g>
    )
  }

  <path class="route" d="M17 73c17-4 27-13 37-9s17 1 25-8"></path>
  <circle class="trail-point" cx="79" cy="56" r="2.8"></circle>
</svg>

<style>
  .trail-mark {
    --mark-color: var(--pct-color-pine-glow);

    display: block;
    width: 5.5rem;
    color: var(--mark-color);
    overflow: visible;
  }

  .trail-mark-desert {
    --mark-atmosphere: var(--pct-color-desert-dust);
  }

  .trail-mark-sierra {
    --mark-atmosphere: var(--pct-color-sierra-snow);
  }

  .trail-mark-norcal {
    --mark-atmosphere: var(--pct-color-norcal-forest);
  }

  .trail-mark-oregon {
    --mark-atmosphere: var(--pct-color-oregon-lake);
  }

  .trail-mark-washington {
    --mark-atmosphere: var(--pct-color-washington-mist);
  }

  path,
  circle {
    vector-effect: non-scaling-stroke;
  }

  .frame,
  .symbol path,
  .symbol circle,
  .route,
  .trail-point {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .frame {
    stroke: var(--pct-color-faint);
    stroke-width: 1;
  }

  .field {
    fill: color-mix(in srgb, var(--mark-atmosphere) 12%, transparent);
    stroke: none;
  }

  .symbol path,
  .symbol circle {
    stroke: var(--mark-atmosphere);
    stroke-width: 2;
  }

  .desert-symbol > circle {
    fill: color-mix(in srgb, var(--mark-atmosphere) 16%, transparent);
  }

  .symbol .detail,
  .mosquito path,
  .mosquito circle,
  .washington-symbol .goat-horns {
    stroke-width: 1.35;
  }

  .washington-symbol .goat-fill {
    fill: color-mix(in srgb, var(--mark-atmosphere) 18%, transparent);
    stroke-width: 1.45;
  }

  .route {
    stroke-width: 2.2;
  }

  .trail-point {
    fill: var(--pct-color-deep-camp);
    stroke-width: 2;
  }

  @media (max-width: 40rem) {
    .trail-mark {
      width: 4.5rem;
    }
  }
</style>
