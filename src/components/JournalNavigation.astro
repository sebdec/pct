---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import { journalDayUrl } from "../lib/content/urls.ts";

interface Props {
  previous: JournalPageViewModel["previous"];
  next: JournalPageViewModel["next"];
}

const { previous, next } = Astro.props;
---

<nav class="journal-navigation" aria-label="Navigation entre les journées">
  {
    previous ? (
      <a
        class="previous"
        href={journalDayUrl(previous.dayId)}
        aria-label={`Jour précédent, jour ${previous.sequence}`}
      >
        <span aria-hidden="true">←</span> Jour {previous.sequence}
      </a>
    ) : (
      <span class="boundary" aria-hidden="true" />
    )
  }

  {
    next ? (
      <a
        class="next"
        href={journalDayUrl(next.dayId)}
        aria-label={`Jour suivant, jour ${next.sequence}`}
      >
        Jour {next.sequence} <span aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="boundary" aria-hidden="true" />
    )
  }
</nav>

<style>
  .journal-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, var(--pct-content-reading));
    margin-inline: auto;
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: var(--pct-space-5);
    border-top: 1px solid var(--pct-color-faint);
  }

  a {
    color: var(--pct-color-muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  a:hover {
    color: var(--pct-color-pine-glow);
  }

  .next {
    text-align: right;
  }

  @media (max-width: 36rem) {
    .boundary {
      min-height: 1px;
    }
  }
</style>
