---
import { sectionNames } from "../lib/site";

const sectionClasses = ["desert", "sierra", "norcal", "oregon", "washington"];
---

<div
  class="trail-sketch"
  aria-label="Aperçu abstrait des 5 sections du parcours"
>
  <div class="map-field" aria-hidden="true">
    <svg viewBox="0 0 420 620" role="presentation">
      <path
        class="contour contour-a"
        d="M18 84C88 26 148 51 204 105s118 55 194-6M2 212c79-43 143-24 197 20s120 56 217-13M16 367c60-49 127-44 184-2s116 60 210 16M-4 526c91-34 150-6 201 35s112 43 217-1"
      ></path>
      <path
        class="contour contour-b"
        d="M49 27c50 52 97 63 143 42s102-17 175 40M14 286c68 44 130 47 184 11s118-28 208 25M25 453c62 29 118 21 166-23s109-50 197-11"
      ></path>
      <path
        class="route-shadow"
        d="M271 585c-45-51-60-99-41-143 18-42 8-73-30-106-38-34-52-76-25-116 25-38 44-59 31-98-9-29-8-56 25-93"
      ></path>
      <path
        class="route"
        d="M271 585c-45-51-60-99-41-143 18-42 8-73-30-106-38-34-52-76-25-116 25-38 44-59 31-98-9-29-8-56 25-93"
      ></path>
      <circle class="route-point" cx="271" cy="585" r="7"></circle>
      <circle class="route-point current" cx="206" cy="122" r="10"></circle>
    </svg>

    <span class="border-label canada">Canada</span>
    <span class="border-label mexico">Mexique</span>
    <span class="map-note"
      >Une carte interactive reliera bientôt chaque mile au journal.</span
    >
  </div>

  <ol>
    {
      sectionNames.map((name, index) => (
        <li class={sectionClasses[index]}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{name}</strong>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .trail-sketch {
    position: relative;
    min-height: 40rem;
    overflow: hidden;
    border: 1px solid var(--pct-color-faint);
    border-radius: var(--pct-radius-medium);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 3%), transparent 30%),
      var(--pct-color-deep-camp);
    box-shadow: 0 2rem 6rem rgb(0 0 0 / 24%);
  }

  .map-field {
    position: absolute;
    inset: 0 10.5rem 0 0;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .contour {
    fill: none;
    stroke: rgb(255 255 255 / 6%);
    stroke-width: 1.2;
  }

  .contour-b {
    stroke: rgb(145 230 165 / 6%);
  }

  .route-shadow,
  .route {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route-shadow {
    stroke: rgb(255 255 255 / 13%);
    stroke-width: 9;
  }

  .route {
    stroke: var(--pct-color-pine-glow);
    stroke-width: 3;
  }

  .route-point {
    fill: var(--pct-color-deep-camp);
    stroke: var(--pct-color-pine-glow);
    stroke-width: 3;
  }

  .route-point.current {
    fill: var(--pct-color-pine-glow);
    stroke: rgb(145 230 165 / 22%);
    stroke-width: 12;
  }

  .border-label {
    position: absolute;
    color: var(--pct-color-muted);
    font-size: 0.52rem;
    letter-spacing: 0.06em;
  }

  .canada {
    top: 1.8rem;
    left: 52%;
  }

  .mexico {
    bottom: 1.8rem;
    left: 58%;
  }

  .map-note {
    position: absolute;
    bottom: 1.75rem;
    left: 1.75rem;
    width: min(15rem, 65%);
    color: var(--pct-color-muted);
    font-family: var(--pct-font-journal);
    font-size: 0.7rem;
    font-style: italic;
    line-height: 1.6;
  }

  ol {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    width: 10.5rem;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--pct-color-faint);
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.45rem;
    padding: 1.1rem;
    border-bottom: 1px solid var(--pct-color-faint);
    background: linear-gradient(135deg, transparent, rgb(255 255 255 / 2%));
  }

  li:last-child {
    border-bottom: 0;
  }

  li span {
    color: var(--section-color);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
  }

  li strong {
    color: var(--pct-color-copy);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .desert {
    --section-color: var(--pct-color-desert-dust);
  }

  .sierra {
    --section-color: var(--pct-color-sierra-snow);
  }

  .norcal {
    --section-color: var(--pct-color-norcal-forest);
  }

  .oregon {
    --section-color: var(--pct-color-oregon-lake);
  }

  .washington {
    --section-color: var(--pct-color-washington-mist);
  }

  @media (max-width: 64rem) {
    .trail-sketch {
      min-height: 32rem;
    }
  }

  @media (max-width: 36rem) {
    .trail-sketch {
      min-height: 29rem;
    }

    .map-field {
      right: 7rem;
    }

    ol {
      width: 7rem;
    }

    li {
      padding: 0.8rem;
    }

    li strong {
      font-size: 0.58rem;
    }

    .map-note {
      display: none;
    }
  }
</style>
