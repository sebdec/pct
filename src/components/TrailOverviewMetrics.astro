---
import type { Locale } from "../lib/content/locales.ts";
import type { TrailOverviewContent } from "../lib/trail/presentation.ts";
import TrailMetricIcon from "./TrailMetricIcon.tsx";
import UnitValue from "./UnitValue.tsx";
import "./TrailMetricLabel.css";
import "./TrailOverviewMetrics.css";

interface Props extends TrailOverviewContent {
  locale: Locale;
}

const { heading, metrics, regionsLabel, regions, locale } = Astro.props;
---

<section
  class="trail-overview-metrics"
  aria-labelledby="trail-overview-heading"
>
  <h2 id="trail-overview-heading">{heading}</h2>

  <dl class="trail-overview-metrics__grid">
    {
      metrics.map(
        ({
          icon,
          label,
          value,
          distanceMiles,
          distanceSuffix,
          elevationMeters,
          elevationPrefix,
          detail,
          detailDistanceMiles,
          detailDistanceSuffix,
          detailElevationMeters,
          detailElevationPrefix,
          detailElevationSuffix,
        }) => (
          <div class="trail-overview-metrics__metric">
            <dt class="trail-metric-label">
              <TrailMetricIcon name={icon} />
              <span>{label}</span>
            </dt>
            <dd>
              <span>
                {distanceMiles !== undefined ? (
                  <UnitValue
                    locale={locale}
                    distanceMiles={distanceMiles}
                    suffix={distanceSuffix}
                  />
                ) : elevationMeters !== undefined ? (
                  <UnitValue
                    locale={locale}
                    elevationMeters={elevationMeters}
                    prefix={elevationPrefix}
                  />
                ) : (
                  value
                )}
              </span>
              {detail ||
              detailDistanceMiles !== undefined ||
              detailElevationMeters !== undefined ? (
                <small>
                  {detailDistanceMiles !== undefined ? (
                    <UnitValue
                      locale={locale}
                      distanceMiles={detailDistanceMiles}
                      suffix={detailDistanceSuffix}
                    />
                  ) : detailElevationMeters !== undefined ? (
                    <UnitValue
                      locale={locale}
                      elevationMeters={detailElevationMeters}
                      prefix={detailElevationPrefix}
                      suffix={detailElevationSuffix}
                    />
                  ) : (
                    detail
                  )}
                </small>
              ) : null}
            </dd>
          </div>
        ),
      )
    }

    <div class="trail-overview-metrics__metric trail-overview-metrics__regions">
      <dt class="trail-metric-label">
        <TrailMetricIcon name="region" />
        <span>{regionsLabel}</span>
      </dt>
      <dd>
        {
          regions.map(({ id, label }) => (
            <span class="trail-overview-metrics__region" data-region={id}>
              {label}
            </span>
          ))
        }
      </dd>
    </div>
  </dl>
</section>
