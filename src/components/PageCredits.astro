---
import TextLink from "./TextLink.astro";
import type { Locale } from "../lib/content/locales.ts";
import { getUi } from "../lib/i18n/ui.ts";

interface CreditLink {
  href: string;
  label: string;
}

interface Props {
  links: CreditLink[];
  locale: Locale;
}

const { links, locale } = Astro.props;
const labels = getUi(locale);
---

<footer class="page-credits">
  <p>
    <strong>{labels.credits}</strong>
    {" "}
    {
      links.map((link, index) => (
        <>
          {index > 0 && ", "}
          <TextLink href={link.href} external>
            {link.label}
          </TextLink>
        </>
      ))
    }
  </p>
</footer>

<style>
  .page-credits {
    padding: var(--pct-space-5) 0;
    color: var(--pct-color-muted);
    font-size: 0.55rem;
    line-height: 1.6;
  }

  p {
    margin: 0;
  }

  strong {
    color: var(--pct-color-copy);
    font-weight: 500;
  }
</style>
