---
import { getCollection } from "astro:content";

import GearWeightChart from "../GearWeightChart.astro";
import PageCredits from "../PageCredits.astro";
import TextLink from "../TextLink.astro";
import UnitValue from "../UnitValue.tsx";
import EditorialPageLayout from "../../layouts/EditorialPageLayout.astro";
import type { Locale } from "../../lib/content/locales.ts";
import { buildGearViewModel } from "../../lib/gear/gearViewModel.ts";
import { site } from "../../lib/site.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [
  gearItemEntries,
  localizedGearEntries,
  productLinkEntries,
  summaryEntries,
] = await Promise.all([
  getCollection("gearItems"),
  getCollection(locale === "fr" ? "gear" : "gearEnglish"),
  getCollection("gearProductLinks"),
  getCollection("gearSummaries"),
]);
const summary = summaryEntries[0]?.data;

if (!summary) {
  throw new Error("Missing equipment summary.");
}

const gear = buildGearViewModel(
  gearItemEntries.map(({ data }) => data),
  localizedGearEntries.map(({ data }) => data),
  productLinkEntries.map(({ data }) => data),
  locale,
);
const copy =
  locale === "fr"
    ? {
        title: "Équipement",
        description:
          "Le matériel emporté sur le Pacific Crest Trail 2026, catégorie par catégorie.",
        listLabel: "Liste de l’équipement",
        temporary: "Temporaire",
      }
    : {
        title: "Gear",
        description:
          "The gear carried on the Pacific Crest Trail in 2026, category by category.",
        listLabel: "Gear list",
        temporary: "Temporary",
      };
const pageTitle = copy.title + " | " + site.title;
---

<EditorialPageLayout
  title={pageTitle}
  description={copy.description}
  heading={copy.title}
  bodyClass="gear-shell"
  {locale}
>
  <GearWeightChart
    baseWeightGrams={summary.baseWeightGrams}
    categories={gear.categories}
    {locale}
  />

  <div class="gear-list" aria-label={copy.listLabel}>
    {
      gear.categories.map((category) => (
        <section
          class:list={{
            "gear-category": true,
            "gear-category--temporary": category.temporary,
          }}
          style={"--gear-category-color: " + category.color}
          aria-labelledby={category.id + "-title"}
        >
          <header class="gear-category__header">
            <div>
              <h2 id={category.id + "-title"}>{category.label}</h2>
              {category.temporary && <span>{copy.temporary}</span>}
            </div>
            <p>
              <strong>
                <UnitValue {locale} weightGrams={category.weightGrams} />
              </strong>
            </p>
          </header>

          <ul>
            {category.items.map((item) => (
              <li>
                <div class="gear-item">
                  <h3>
                    {item.productUrl ? (
                      <TextLink href={item.productUrl} external>
                        {item.name}
                      </TextLink>
                    ) : (
                      item.name
                    )}
                  </h3>
                  {item.detail && <p>{item.detail}</p>}
                </div>
                <p class="gear-item__weight">
                  <UnitValue {locale} weightGrams={item.weightGrams} />
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <Fragment slot="after-main">
    <PageCredits
      {locale}
      links={[{ href: summary.sourceUrl, label: "LighterPack" }]}
    />
  </Fragment>
</EditorialPageLayout>

<style>
  .gear-category {
    margin-top: var(--pct-space-7);
    border-top: 2px solid var(--gear-category-color);
  }

  .gear-category:first-child {
    margin-top: 0;
  }

  .gear-category__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--pct-space-5);
    padding: 1.25rem 0 1.1rem;
  }

  .gear-category__header > div {
    display: flex;
    align-items: baseline;
    gap: var(--pct-space-3);
  }

  .gear-category__header h2 {
    display: flex;
    gap: var(--pct-space-3);
    align-items: center;
    margin: 0;
    color: var(--pct-color-white);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .gear-category__header h2::before {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--gear-category-color);
    content: "";
  }

  .gear-category__header span {
    color: var(--pct-color-sierra-snow);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
  }

  .gear-category__header > p {
    margin: 0;
    color: var(--pct-color-copy);
    font-size: 0.78rem;
  }

  .gear-category__header strong {
    min-width: 4.5rem;
    color: var(--pct-color-copy);
    font-weight: 500;
    text-align: right;
  }

  .gear-category ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--pct-color-faint);
    list-style: none;
  }

  .gear-category li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--pct-space-5);
    align-items: center;
    min-height: 3.85rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--pct-color-faint);
  }

  .gear-item {
    min-width: 0;
  }

  .gear-item h3 {
    margin: 0;
    color: var(--pct-color-white);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .gear-item > p {
    margin: var(--pct-space-1) 0 0;
    overflow: hidden;
    color: var(--pct-color-muted);
    font-family: var(--pct-font-journal);
    font-size: 0.74rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gear-item__weight {
    min-width: 4.5rem;
    margin: 0;
    color: var(--pct-color-copy);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .gear-category__header {
      align-items: flex-end;
    }

    .gear-category__header strong {
      text-align: right;
    }

    .gear-item > p {
      white-space: normal;
    }
  }
</style>
