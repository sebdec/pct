---
import TrailOverviewMetrics from "../TrailOverviewMetrics.astro";
import TextLink from "../TextLink.astro";
import { Content as EnglishHomeContent } from "../../content/home/en.md";
import { Content as FrenchHomeContent } from "../../content/home/fr.md";
import {
  homeIntroduction as englishHomeIntroduction,
  homeOverview as englishHomeOverview,
} from "../../content/home/en.ts";
import {
  homeIntroduction as frenchHomeIntroduction,
  homeOverview as frenchHomeOverview,
} from "../../content/home/fr.ts";
import EditorialPageLayout from "../../layouts/EditorialPageLayout.astro";
import type { Locale } from "../../lib/content/locales.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const HomeContent = locale === "fr" ? FrenchHomeContent : EnglishHomeContent;
const homeIntroduction =
  locale === "fr" ? frenchHomeIntroduction : englishHomeIntroduction;
const homeOverview = locale === "fr" ? frenchHomeOverview : englishHomeOverview;
---

<EditorialPageLayout
  title="Pacific Crest Trail 2026"
  description={locale === "fr"
    ? "Le journal, la carte et les chiffres d’un thru-hike de 2 656 miles sur le Pacific Crest Trail en 2026."
    : "The journal, map and numbers from a 2,656-mile Pacific Crest Trail thru-hike in 2026."}
  heading="Pacific Crest Trail 2026"
  bodyClass="home-shell"
  {locale}
>
  <article class="editorial-rich-text">
    <p>
      {homeIntroduction.beforeLink}<TextLink
        href={homeIntroduction.linkHref}
        external>{homeIntroduction.linkLabel}</TextLink
      >{homeIntroduction.afterLink}
    </p>
    <TrailOverviewMetrics {...homeOverview} locale={locale} />
    <HomeContent />
  </article>
</EditorialPageLayout>
