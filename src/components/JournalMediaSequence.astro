---
import type { JournalPageViewModel } from "../lib/content/journalViewModel.ts";
import { defaultLocale, type Locale } from "../lib/content/locales.ts";
import { getUi } from "../lib/i18n/ui.ts";

interface Props {
  photos: JournalPageViewModel["photos"];
  regionId: JournalPageViewModel["regionId"];
  locale?: Locale;
}

const { photos, regionId, locale = defaultLocale } = Astro.props;
const labels = getUi(locale);
const priorityPhotoId = photos.find(({ state }) => state === "published")
  ?.placement.id;

function orientation(
  width: number,
  height: number,
): "landscape" | "portrait" | "square" {
  if (width / height > 1.15) {
    return "landscape";
  }

  if (height / width > 1.15) {
    return "portrait";
  }

  return "square";
}

function srcset(
  variants: readonly {
    width: number;
    url?: string | undefined;
  }[],
): string {
  return variants
    .filter((variant): variant is { width: number; url: string } =>
      Boolean(variant.url),
    )
    .toSorted((left, right) => left.width - right.width)
    .map(({ width, url }) => `${url} ${width}w`)
    .join(", ");
}
---

{
  photos.length > 0 && (
    <section
      class:list={[
        "media-sequence",
        regionId ? `media-${regionId}` : "media-after-trail",
      ]}
      aria-label={labels.journalPhotos}
    >
      <div class="media-grid">
        {photos.map((photo, index) => {
          const { placement } = photo;
          const photoOrientation = orientation(
            placement.width,
            placement.height,
          );

          if (photo.state === "placeholder") {
            return (
              <figure
                class:list={[
                  photoOrientation,
                  index % 3 === 0 && "featured",
                  "unpublished",
                ]}
              >
                <div
                  class="photo-field"
                  style={`--photo-ratio: ${placement.width} / ${placement.height}; --photo-shift: ${index + 1}`}
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 300 220" preserveAspectRatio="none">
                    <path d="M-20 166C38 95 94 104 140 148s95 43 180-31" />
                    <path d="M-15 193c58-49 107-41 151-10s95 32 177-22" />
                    <circle cx="232" cy="54" r="22" />
                  </svg>
                  <span>{labels.photoPlaceholder}</span>
                </div>
              </figure>
            );
          }

          const { asset, copy } = photo;
          const avifVariants = asset.variants.filter(
            ({ format }) => format === "avif",
          );
          const webpVariants = asset.variants.filter(
            ({ format }) => format === "webp",
          );
          const fallback = webpVariants
            .filter((variant): variant is typeof variant & { url: string } =>
              Boolean(variant.url),
            )
            .toSorted((left, right) => right.width - left.width)[0];
          const isPriority = placement.id === priorityPhotoId;

          return (
            <figure
              class:list={[photoOrientation, index % 3 === 0 && "featured"]}
            >
              <picture
                class="photo-field published-photo"
                style={`--photo-ratio: ${asset.width} / ${asset.height}; --photo-placeholder: url("${asset.placeholder.dataUrl}")`}
              >
                <source
                  type="image/avif"
                  srcset={srcset(avifVariants)}
                  sizes="(max-width: 36rem) calc(100vw - 2rem), min(100vw - 4rem, 70rem)"
                />
                <source
                  type="image/webp"
                  srcset={srcset(webpVariants)}
                  sizes="(max-width: 36rem) calc(100vw - 2rem), min(100vw - 4rem, 70rem)"
                />
                <img
                  src={fallback.url}
                  alt={copy.alt}
                  width={asset.width}
                  height={asset.height}
                  loading={isPriority ? "eager" : "lazy"}
                  fetchpriority={isPriority ? "high" : "auto"}
                  decoding="async"
                />
              </picture>
              {copy.caption && <figcaption>{copy.caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .media-sequence {
    --media-color: var(--pct-color-pine-glow);

    margin-top: clamp(4rem, 9vw, 7rem);
    padding-top: var(--pct-space-6);
    border-top: 1px solid var(--pct-color-faint);
  }

  .media-desert {
    --media-color: var(--pct-color-desert-dust);
  }

  .media-sierra {
    --media-color: var(--pct-color-sierra-snow);
  }

  .media-norcal {
    --media-color: var(--pct-color-norcal-forest);
  }

  .media-oregon {
    --media-color: var(--pct-color-oregon-lake);
  }

  .media-washington {
    --media-color: var(--pct-color-washington-mist);
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pct-space-5);
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  figure.landscape,
  figure.featured {
    grid-column: 1 / -1;
  }

  .photo-field {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: var(--photo-ratio);
    min-height: 13rem;
    overflow: hidden;
    place-items: end start;
    border: 1px solid var(--pct-color-faint);
    background:
      radial-gradient(
        circle at calc(18% + var(--photo-shift) * 7%) 24%,
        color-mix(in srgb, var(--media-color) 20%, transparent),
        transparent 36%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--pct-color-night-trail) 76%, transparent),
        var(--pct-color-deep-camp)
      );
  }

  .published-photo {
    min-height: 0;
    background-color: var(--pct-color-deep-camp);
    background-image: var(--photo-placeholder);
    background-position: center;
    background-size: cover;
  }

  .published-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .unpublished .photo-field::after {
    position: absolute;
    inset: var(--pct-space-3);
    border: 1px solid color-mix(in srgb, var(--media-color) 22%, transparent);
    content: "";
  }

  .unpublished svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: color-mix(in srgb, var(--media-color) 30%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .unpublished circle {
    fill: color-mix(in srgb, var(--media-color) 8%, transparent);
  }

  .unpublished .photo-field > span {
    position: relative;
    z-index: 1;
    margin: var(--pct-space-5);
    color: var(--pct-color-copy);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
  }

  figcaption {
    margin-top: var(--pct-space-2);
    color: var(--pct-color-muted);
    font-family: var(--pct-font-journal);
    font-size: 0.72rem;
    font-style: italic;
    line-height: 1.5;
  }

  @media (max-width: 36rem) {
    .media-grid {
      grid-template-columns: 1fr;
    }

    figure.landscape,
    figure.featured {
      grid-column: auto;
    }

    .unpublished .photo-field {
      min-height: 11rem;
    }
  }
</style>
